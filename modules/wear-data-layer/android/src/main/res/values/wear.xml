<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Capability the phone app advertises on the Wear network (Story 10-6).

      This is how the WATCH learns that the phone app is reachable. `CapabilityClient` on the
      watch listens for this name and reports the nodes providing it, which is what triggers the
      `requestCards` ping (AC5) and the `CARD_USED` outbox flush (AC15). Raw node connectivity is
      not a substitute: a phone can be connected while this app is not installed on it, and a
      message sent to such a node fails in a way indistinguishable from being offline.

      It lives in the local Expo module rather than in `android/res/` because `android/` is
      gitignored and regenerated by `expo prebuild`; the resource merger folds this file into the
      generated app the same way it folds in the module's AndroidManifest entries.

      The name is mirrored in `WearSyncContract.PHONE_CAPABILITY` in the Wear APK. Renaming one
      side alone silently disables reconnection sync — there is no build-time link between them.
    -->
    <string-array name="android_wear_capabilities">
        <item>myloyaltycards_phone</item>
    </string-array>

</resources>
