#!/bin/sh
# Pre-push hook: Run full typecheck and tests

echo "Running typecheck..."
yarn typecheck || exit 1

echo "Checking design tokens are in sync..."
yarn tokens:check || exit 1

echo "Checking the splash icon is in sync with the app icon..."
yarn splash:check || exit 1

echo "Running lint..."
yarn lint || exit 1

# Catches files that skipped lint-staged (bot/agent commits, `commit -n`) before
# CI does. Run `yarn format` to fix.
echo "Checking formatting..."
yarn format:check || exit 1

echo "Running tests..."
yarn test || exit 1

echo "All checks passed!"
