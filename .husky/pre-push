#!/bin/sh
# Pre-push hook: Run full typecheck and tests

echo "Running typecheck..."
yarn typecheck || exit 1

echo "Checking design tokens are in sync..."
yarn tokens:check || exit 1

echo "Checking the brand icons are in sync with the mark..."
yarn icons:check || exit 1

# The design frames are generated and .prettierignore'd, which makes their
# generators the source of truth -- so a stale one silently reverting corrected
# artwork is a real failure mode, and it has happened once already.
echo "Checking the design frames still match their generators..."
yarn frames:check || exit 1

# Pure Node, unlike the watchOS equivalent (`check:catalogue-generated` needs `xcrun swift`),
# so it runs on any machine and belongs here rather than only in CI.
echo "Checking the Wear OS brand catalogue is in sync..."
yarn wear:catalogue:check || exit 1

echo "Running lint..."
yarn lint || exit 1

# Mirrored from CI deliberately, unlike most gates: a `patch-package` patch lives in
# the uncommitted `node_modules`, so it can be lost by a dep refresh or a stale
# install with nothing else complaining — and the loss reintroduces a bug that
# already cost one forensics session to diagnose (Story 16.23). Catching that
# before the push is worth the second or two it takes.
echo "Verifying native patches are applied..."
yarn check:native-patches || exit 1

# Same reasoning, different fragility: a classifier matches on upstream message
# text, so an `expo-camera` reword would silently degrade telemetry to `other`.
echo "Verifying upstream native strings still exist..."
yarn check:native-strings || exit 1

# Catches files that skipped lint-staged (bot/agent commits, `commit -n`) before
# CI does. Run `yarn format` to fix.
echo "Checking formatting..."
yarn format:check || exit 1

echo "Running tests..."
yarn test || exit 1

echo "All checks passed!"
