default_platform(:ios)

app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
watch_identifier = "#{app_identifier}.watch"
# The watch complication is a WidgetKit extension embedded in the watch app. It
# carries the App Groups entitlement, so it needs its own explicit App ID and
# match profile (a wildcard App ID can't hold App Groups).
widget_identifier = "#{watch_identifier}.widget"

def matched_profile_mapping(*bundle_ids)
  mapping = lane_context[Fastlane::Actions::SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}

  bundle_ids.each_with_object({}) do |bundle_id, profiles|
    matched_profile = mapping[bundle_id]
    UI.user_error!("Missing match provisioning profile for #{bundle_id}") unless matched_profile

    profiles[bundle_id] = matched_profile
  end
end

platform :ios do
  before_all do
    # Creates a temporary keychain for match on CI runners.
    # No-op when running locally (unless force: true).
    setup_ci if is_ci
  end

  # Resolves match profiles for the iOS app, the watch app, and the watch
  # widget extension, applies manual code-signing to each target, and returns
  # the bundle-id => profile-name mapping for build_app's export options.
  # All distribution lanes go through here so a target can never be forgotten.
  private_lane :apply_distribution_signing do |options|
    targets_by_identifier = {
      app_identifier => "myLoyaltyCards",
      watch_identifier => "watch",
      widget_identifier => "watchwidget"
    }

    targets_by_identifier.each_key do |bundle_id|
      match(type: options[:match_type], app_identifier: bundle_id, readonly: is_ci)
    end

    profile_mapping = matched_profile_mapping(*targets_by_identifier.keys)

    targets_by_identifier.each do |bundle_id, target_name|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "ios/myLoyaltyCards.xcodeproj",
        team_id: ENV['FASTLANE_TEAM_ID'],
        profile_name: profile_mapping.fetch(bundle_id),
        code_sign_identity: "iPhone Distribution",
        targets: [target_name]
      )
    end

    profile_mapping
  end

  desc "Fetch certificates (appstore, adhoc, development)"
  lane :fetch_certificates do
    [app_identifier, watch_identifier, widget_identifier].each do |id|
      match(
        type: 'development',
        app_identifier: id
      )
      match(
        type: 'adhoc',
        app_identifier: id
      )
      match(
        type: 'appstore',
        app_identifier: id
      )
    end
  end

  desc "Build iOS Dev app"
  lane :build_dev do
    build_app(
      scheme: "myLoyaltyCards",
      export_method: "development",
      xcargs: "DEVELOPMENT_TEAM='#{ENV['FASTLANE_TEAM_ID']}'"
    )
  end

  desc "Build iOS AdHoc app"
  lane :adhoc do
    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY_KEY'],
      in_house: false
    )

    # Sign the iOS app, watch app, and watch widget extension, then export with
    # the exact profile names resolved by match.
    profile_mapping = apply_distribution_signing(match_type: "adhoc")

    # Use CI run number for a guaranteed-unique, ever-increasing build number.
    # Falls back to Unix timestamp when running locally.
    build_number = ENV['GITHUB_RUN_NUMBER'] || Time.now.to_i.to_s
    increment_build_number(
      xcodeproj: "ios/myLoyaltyCards.xcodeproj",
      build_number: build_number
    )
    build_app(
      scheme: "myLoyaltyCards",
      workspace: "ios/myLoyaltyCards.xcworkspace",
      export_method: "ad-hoc",
      output_directory: "output",
      export_options: {
        provisioningProfiles: profile_mapping
      },
      xcargs: "DEVELOPMENT_TEAM='#{ENV['FASTLANE_TEAM_ID']}'"
    )
  end

  # Build the app-store IPA and (unless told not to) send it to TestFlight.
  #
  # ONE BODY, TWO LANES: `beta` (RC) and `nightly` (Story 16.36) ship the same binary to the
  # same place by the same rules. They are separate lanes only so the intent is visible in the
  # workflow that calls them; a second copy of this body would be a place for them to drift.
  #
  # THE APPLE WATCH RIDES ALONG, and needs nothing here. `apply_distribution_signing` wires all
  # three targets — phone, watch app, WidgetKit complication — and Apple provides no standalone
  # watchOS upload at all (ADR-2026-04-11-002), so one TestFlight upload delivers all three.
  #
  # THE BUILD NUMBER COMES FROM REMOTE STATE, not from GITHUB_RUN_NUMBER, and that is why iOS
  # needs no versionCode-style band scheme the way Android does: asking App Store Connect for
  # the highest build number is inherently workflow-independent, so the RC and nightly
  # pipelines cannot collide however many times either runs.
  private_lane :ship_ios! do |options|
    upload = options.fetch(:upload)

    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY_KEY'],
      in_house: false
    )

    profile_mapping = apply_distribution_signing(match_type: "appstore")

    # Retrieve last build number from TestFlight and increment
    last_build = latest_testflight_build_number(
      app_identifier: app_identifier,
      api_key: api_key
    )
    increment_build_number(
      xcodeproj: "ios/myLoyaltyCards.xcodeproj",
      build_number: (last_build.to_i + 1).to_s
    )
    build_app(
      scheme: "myLoyaltyCards",
      workspace: "ios/myLoyaltyCards.xcworkspace",
      export_method: "app-store",
      output_directory: "output",
      export_options: {
        provisioningProfiles: profile_mapping
      },
      xcargs: "DEVELOPMENT_TEAM='#{ENV['FASTLANE_TEAM_ID']}'"
    )

    unless upload
      # `dry_run` from the nightly's workflow_dispatch. Everything expensive and everything
      # that can fail has already run; what is skipped is the one irreversible step. A
      # TestFlight build number is consumed by an UPLOAD, not by asking for the last one, so a
      # dry run costs nothing but minutes and leaves the IPA as a workflow artifact.
      UI.important("DRY RUN — built the app-store IPA, skipping the TestFlight upload.")
      next
    end

    upload_to_testflight(
      api_key: api_key
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    ship_ios!(upload: true)
  end

  # Nightly internal build (Story 16.36). Identical to `beta` by design — see `ship_ios!`.
  #
  # There is deliberately NO `groups:` here and none in `beta`: a bare `upload_to_testflight`
  # delivers to App Store Connect INTERNAL users, which is already exactly what "the internal
  # track" means on iOS. Adding a group would change who gets RC builds too.
  desc "Nightly internal build → TestFlight (Story 16.36)"
  lane :nightly do |options|
    ship_ios!(upload: !options[:dry_run])
  end

  desc "Build and upload to App Store Connect (release)"
  lane :upload_release do
    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY_KEY'],
      in_house: false
    )

    profile_mapping = apply_distribution_signing(match_type: "appstore")

    build_number = ENV['GITHUB_RUN_NUMBER'] || Time.now.to_i.to_s
    increment_build_number(
      xcodeproj: "ios/myLoyaltyCards.xcodeproj",
      build_number: build_number
    )
    build_app(
      scheme: "myLoyaltyCards",
      workspace: "ios/myLoyaltyCards.xcworkspace",
      export_method: "app-store",
      output_directory: "output",
      export_options: {
        provisioningProfiles: profile_mapping
      },
      xcargs: "DEVELOPMENT_TEAM='#{ENV['FASTLANE_TEAM_ID']}'"
    )
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end
end

# Release-signing credentials the Android release build requires. The
# Expo-generated build.gradle points the `release` buildType at the *debug*
# signingConfig, so real upload-key signing only happens when these are injected
# via gradle. Guard their presence so a release can never silently ship
# debug-signed. (Story 16.7, AC5)
ANDROID_SIGNING_ENV_VARS = %w[
  ANDROID_KEYSTORE_PATH
  ANDROID_KEYSTORE_PASSWORD
  ANDROID_KEY_ALIAS
  ANDROID_KEY_PASSWORD
].freeze

def ensure_android_signing_env!
  missing = ANDROID_SIGNING_ENV_VARS.select { |name| ENV[name].to_s.strip.empty? }
  UI.user_error!("Missing Android release-signing env var(s): #{missing.join(', ')}") unless missing.empty?
end

# Artifact paths shared by the phone and Wear halves of an Android release
# (Story 16.35). Named here rather than inlined so the upload, the signing-parity
# check and the "did it actually build" guard can never drift apart.
#
# Kept project-root-relative for readability, and ALWAYS passed through
# `project_path` before use — see the warning on that method. Do not hand a bare
# constant to `Dir.glob`, `File.exist?` or `sh`.
PHONE_RELEASE_AAB = "android/app/build/outputs/bundle/release/app-release.aab".freeze
WEAR_RELEASE_BUNDLE_DIR = "watch-android/app/build/outputs/bundle/release".freeze

# ⚠️ A LANE BODY'S WORKING DIRECTORY IS `fastlane/`, NOT THE PROJECT ROOT.
#
# fastlane wraps the entire lane in `Dir.chdir(FastlaneCore::FastlaneFolder.path)`
# (`runner.rb`) and chdirs out to the project root only *inside* an action
# (`execute_action`'s `custom_dir` defaults to `".."`). So within one lane there are
# two different working directories:
#
#   * action PARAMETERS (`gradle(project_dir:)`, `upload_to_play_store(aab:)`) are
#     resolved by the action, i.e. against the PROJECT ROOT — which is why the
#     relative paths elsewhere in this file work;
#   * raw Ruby in the lane body (`Dir.glob`, `File.exist?`) and `sh` both run
#     against `fastlane/`, because `FastFile#sh` calls `Actions.sh_no_action`
#     directly and never chdirs.
#
# That split silently broke the first draft of `wear_release_bundle!`: its glob found
# nothing even with the APK on disk, aborting the lane AFTER the phone AAB had been
# uploaded — the phone-only release this whole story exists to prevent. Absolute
# paths are correct under both directories, so everything goes through here.
def project_path(relative)
  File.expand_path(relative, File.expand_path("..", FastlaneCore::FastlaneFolder.path || Dir.pwd))
end

# Resolve the Wear OS release BUNDLE by globbing rather than by name.
#
# Wear ships an AAB, not an APK. Play refuses raw APKs for this application entirely
# ("Invalid request - APKs are not allowed for this application", RC v1.0.0-rc.20): once an
# app is on App Bundles there is no APK upload path, on any track. `watch-android/README.md`
# still described the historical "a Wear app is a separate APK" model, which is true of the
# artifact format in general and false for this Play listing.
#
# NOTE the asymmetry with APKs, because it removes a guard that used to exist here: AGP names
# an UNSIGNED bundle `app-release.aab`, byte-identical in name to a signed one — there is no
# `-unsigned` suffix the way `assembleRelease` produces `app-release-unsigned.apk`. Verified
# locally. So the filename cannot tell you whether signing was injected, and the only real
# check is the signing-parity step, whose `keytool` call reports "Not a signed jar file" and
# fails with a clear message. Do not re-add a name-based guard here; it would be theatre.
def wear_release_bundle!
  # Absolute — a lane body's cwd is `fastlane/`. See `project_path`.
  candidates = Dir.glob(File.join(project_path(WEAR_RELEASE_BUNDLE_DIR), "*.aab")).sort

  if candidates.empty?
    UI.user_error!(
      "No Wear OS release bundle in #{WEAR_RELEASE_BUNDLE_DIR}. Failing here rather than " \
      "publishing a phone-only release (Story 16.35, AC6)."
    )
  end
  if candidates.length > 1
    UI.user_error!(
      "Expected exactly one Wear OS release bundle in #{WEAR_RELEASE_BUNDLE_DIR}, found " \
      "#{candidates.length}: #{candidates.join(', ')}. Refusing to guess which one to ship."
    )
  end

  candidates.first
end

platform :android do
  package_name = ENV['ANDROID_PACKAGE_NAME'] || CredentialsManager::AppfileConfig.try_fetch_value(:package_name)
  json_key_data = ENV['PLAY_STORE_API_KEY']

  desc "Build Android Dev app"
  lane :build_dev do
    gradle(task: "assembleDebug", project_dir: "android")
  end

  # Build, sign and verify the Wear OS companion BUNDLE (Story 16.35). Uploading it is
  # `upload_wear_bundle!`'s job, and it goes to its own `wear:` form-factor track.
  #
  # An AAB, not an APK: Play refuses raw APKs for this application on ANY track
  # ("Invalid request - APKs are not allowed for this application", RC v1.0.0-rc.20).
  #
  # BUILD EVERYTHING BEFORE UPLOADING ANYTHING. The two halves are deliberately
  # separate lanes so a release lane reads:
  #
  #   build phone AAB -> build+verify Wear AAB -> upload phone -> upload Wear
  #
  # rather than interleaving a build between the two uploads. Every non-Play failure
  # mode — a Kotlin compile error, an R8 failure, a missing or unsigned artifact, a
  # signing-certificate mismatch — then happens while nothing has been uploaded yet.
  # What remains inside the risk window is only the two `upload_to_play_store` calls,
  # and that window is irreducible: `supply` declares `:apk`/`:apk_paths` as
  # `conflicting_options` with `:aab`/`:aab_paths` (supply/lib/supply/options.rb:125,136,153),
  # so one invocation carries APKs or bundles, never both. The two uploads target DIFFERENT
  # tracks (the phone's, and `wear:<track>`), so they cannot race each other — see
  # `upload_wear_bundle!`.
  # Interleaving would reintroduce the phone-only release through a different door.
  #
  # The Wear versionCode band is chosen HERE from the upload track, not in the
  # workflow, so the band and the destination track cannot disagree. See
  # `wearProductionVersionCodeOffset` in watch-android/app/build.gradle.kts.
  #
  # Returns the absolute path to the verified, signed Wear bundle.
  # Which Wear `versionCode` band each phone track implies. Derived from the destination
  # rather than passed in separately, so the band can never disagree with where the artifact
  # is going — see `wearVersionCodeBand` in watch-android/app/build.gradle.kts.
  #
  # `internal` maps to the nightly band because the nightly is the only pipeline that uploads
  # there (Story 16.36). Anything unlisted falls through to `beta`, which is the deliberate
  # safe default: colliding with a *future* production or nightly code is a hard Play
  # rejection you find immediately, while colliding with an already-uploaded RC code is the
  # plausible-looking failure the band scheme exists to prevent.
  # A `def`, not a constant, deliberately: a constant assigned inside a `platform` block is not
  # reachable from every scope the Fastfile evaluates in, while a `def` is — the same shape
  # `wear_play_track` uses.
  def wear_band_for(phone_track)
    { "production" => "production", "internal" => "nightly" }.fetch(phone_track, "beta")
  end

  private_lane :build_wear_bundle! do |options|
    track = options.fetch(:track)
    ENV['WEAR_RELEASE_TRACK'] = wear_band_for(track)

    gradle(
      task: "bundleRelease",
      project_dir: "watch-android",
      properties: {
        "android.injected.signing.store.file" => ENV['ANDROID_KEYSTORE_PATH'],
        "android.injected.signing.store.password" => ENV['ANDROID_KEYSTORE_PASSWORD'],
        "android.injected.signing.key.alias" => ENV['ANDROID_KEY_ALIAS'],
        "android.injected.signing.key.password" => ENV['ANDROID_KEY_PASSWORD']
      }
    )

    # AC6: rejects both "nothing was built" and "what was built is unsigned".
    wear_bundle = wear_release_bundle!

    # AC5: both artifacts must carry the SAME signing certificate. A wrong-key artifact
    # uploads cleanly and then breaks the Wearable Data Layer with no crash and no
    # telemetry. This ALSO doubles as the unsigned check for the bundle — an unsigned AAB
    # is named `app-release.aab` exactly like a signed one, so only `keytool` can tell them
    # apart. The check prints the fingerprint the Digital Asset Links entry needs.
    # All paths absolute: `sh` runs from `fastlane/`. See `project_path`.
    sh(
      "node",
      project_path("scripts/check-android-signing-parity.mjs"),
      project_path(PHONE_RELEASE_AAB),
      wear_bundle
    )

    wear_bundle
  end

  # Prefix Play uses for Wear OS form-factor track IDs (Story 16.35).
  #
  # Wear OS artifacts DO NOT go on the phone's track. Play requires a dedicated
  # form-factor track whose id is `"[prefix]:defaultTrackName"` — `wear:alpha`,
  # `wear:production` — and it REJECTS an artifact declaring
  # `uses-feature android.hardware.type.watch` uploaded to a mobile track:
  #
  #   "If you want to continue distributing your app to Wear OS devices, you must use
  #    dedicated Wear OS tracks and create new releases on these tracks."
  #    — support.google.com/googleplay/android-developer/answer/13295490
  #   Track-id rule: developers.google.com/android-publisher/tracks
  #
  # This corrected an earlier design in this same story that uploaded the Wear APK to the
  # phone's own track and used `version_codes_to_retain` to keep both version codes in one
  # release. That would have been rejected by Play on the first real run — AFTER the phone
  # AAB was already committed. Do not reintroduce it.
  WEAR_TRACK_PREFIX = "wear".freeze

  # Resolve the Play track the Wear bundle goes to.
  #
  # ⚠️ `wear:` + the phone's track name is NOT a reliable derivation, and RC v1.0.0-rc.21
  # proved it: the phone ships to `alpha`, and `wear:alpha` came back
  # `Track not found`. Per developers.google.com/android-publisher/tracks only three Wear
  # track names are WELL KNOWN — `wear:production`, `wear:beta` (open testing) and
  # `wear:qa` (internal testing; note it is "qa", not "internal"). Everything else is a
  # CLOSED testing track, which is created by hand and carries a custom name, so
  # `wear:alpha` exists only if someone made a Wear closed track literally called "alpha".
  #
  # So the derived value is a DEFAULT, not a rule. `WEAR_PLAY_TRACK` overrides it outright
  # for whatever this app's Console actually has. Set it in the release workflow rather
  # than editing the default here, so the phone and Wear tracks stay visibly paired.
  def wear_play_track(phone_track)
    override = ENV['WEAR_PLAY_TRACK'].to_s.strip
    return override unless override.empty?

    "#{WEAR_TRACK_PREFIX}:#{phone_track}"
  end

  # Wear track names that are NOT derivable from the phone track they pair with, and what to
  # use instead. Play's three WELL-KNOWN Wear names are `wear:production`, `wear:beta` and
  # `wear:qa`; everything else is a hand-created closed track. `wear:alpha` therefore exists
  # for THIS app only because someone made a closed track called "alpha" — which is why the
  # derivation is a default rather than a rule, and why this list is a deny-list of known-bad
  # derivations rather than an allow-list of good ones. An allow-list would break the RC lane.
  UNDERIVABLE_WEAR_TRACKS = {
    # Play names the Wear internal-testing track `qa`, not `internal`.
    "internal" => "wear:qa"
  }.freeze

  # Fail BEFORE anything is built or uploaded when the Wear destination cannot be derived and
  # no override was given.
  #
  # This lives in `ship_android!`, not in the `nightly` lane, on purpose: `wear_play_track` is
  # only consulted inside `upload_wear_bundle!` — i.e. AFTER the phone AAB has been uploaded —
  # so relying on it to fail would produce exactly the phone-only release Story 16.35 exists to
  # prevent, and exactly the "guard evaluated too late" defect its review finding #2 caught.
  # Putting it here means any future caller of `ship_android!` inherits the protection instead
  # of having to remember it.
  def ensure_wear_track_resolvable!(phone_track)
    return unless UNDERIVABLE_WEAR_TRACKS.key?(phone_track)
    return unless ENV['WEAR_PLAY_TRACK'].to_s.strip.empty?

    expected = UNDERIVABLE_WEAR_TRACKS.fetch(phone_track)
    UI.user_error!(
      "WEAR_PLAY_TRACK is not set, and `wear:#{phone_track}` DOES NOT EXIST — Play names " \
      "the Wear counterpart of `#{phone_track}` `#{expected}`. Set WEAR_PLAY_TRACK=#{expected} " \
      "in the workflow. Failing now, before anything is built or uploaded, so this cannot " \
      "ship the phone without the watch (Story 16.35's failure mode)."
    )
  end

  # Ask Play which tracks this app actually has, for the `Track not found` message.
  #
  # Wrapped so it can NEVER replace the real failure: a diagnostic that throws while
  # explaining another throw is worse than no diagnostic. Returns nil when it cannot tell.
  # A fresh edit is used deliberately — the one the failed upload was holding is dead.
  def available_play_tracks
    client = Supply::Client.make_from_config(params: Supply.config)
    client.begin_edit(package_name: Supply.config[:package_name])
    names = client.tracks.map(&:track).compact.sort
    client.abort_current_edit
    names
  rescue StandardError => diagnostic_error
    UI.error("(could not list this app's Play tracks: #{diagnostic_error.message})")
    nil
  end

  # Upload the already-built, already-verified Wear APK to its own form-factor track.
  #
  # Because this is a SEPARATE track from the phone's, the release is independent — which
  # removes three hazards the previous same-track design had to defend against:
  #
  #   * no `version_codes_to_retain`. Nothing of the phone's lives on this track, so there is
  #     no release for this call to overwrite. (Passing the phone's code here would be worse
  #     than useless: it names a version code this track has never seen.)
  #   * no track-edit race between the phone and Wear uploads — different tracks, different
  #     edits. They stay in one job because the two artifacts belong to one release *intent*
  #     and a partial ship should be one red X, not two green ones.
  #   * `versionCode` still has to be globally unique per applicationId ACROSS form factors,
  #     which is why the band scheme in watch-android/app/build.gradle.kts is unchanged.
  #
  # `supply` still cannot carry an AAB and an APK in one invocation — `:apk`/`:apk_paths` are
  # declared `conflicting_options` with `:aab`/`:aab_paths` — so this remains a second call.
  private_lane :upload_wear_bundle! do |options|
    phone_track = options.fetch(:track)
    wear_track = wear_play_track(phone_track)
    release_status = options.fetch(:release_status)

    begin
      upload_to_play_store(
        package_name: package_name,
        json_key_data: json_key_data,
        track: wear_track,
        release_status: release_status,
        aab: options.fetch(:aab),
        # Wear ships a BUNDLE. `skip_upload_apk` keeps supply from picking up any stray
        # APK — the phone's `bundleRelease` leaves none, but the guard costs nothing and
        # the symmetric mistake on the phone side is what broke RC v1.0.0-rc.19.
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    rescue StandardError => error
      # Nothing here swallows the failure — the `raise` below re-throws it untouched. What
      # this adds is the STATE, which a bare red X does not convey: by this point the phone
      # AAB is already committed, so "the release failed" and "the phone shipped without the
      # watch" look identical to whoever is on call.
      UI.error("=" * 78)
      UI.error("WEAR OS UPLOAD FAILED — THE PHONE AAB IS ALREADY PUBLISHED.")
      UI.error("Phone: '#{release_status}' release on '#{phone_track}' — already published,")
      UI.error("       and unaffected by this failure (it is a different track).")
      UI.error("Watch: NOT published. Target track was '#{wear_track}'.")
      UI.error("")
      # `Track not found` is the signature of the one-time Play Console step never having been
      # done, and it is worth naming explicitly: the raw API error does not say what to click.
      if error.message.to_s.match?(/track not found/i)
        UI.error("'#{wear_track}' DOES NOT EXIST for this app. Two possible causes:")
        UI.error("")
        UI.error("1. The Wear OS form factor is not enabled. Enable it once, by hand:")
        UI.error("     Advanced settings -> Form factors -> Wear OS -> Manage")
        UI.error("     -> 'Use a dedicated release track for Wear OS'")
        UI.error("2. It IS enabled, but this track name is wrong. Only wear:production,")
        UI.error("   wear:beta and wear:qa are well-known names; anything else is a CLOSED")
        UI.error("   track created by hand with a custom name. Note the phone's 'alpha' has")
        UI.error("   no automatic Wear equivalent.")
        UI.error("")
        UI.error("Set WEAR_PLAY_TRACK in the release workflow to override the default.")

        tracks = available_play_tracks
        if tracks
          UI.error("")
          UI.error("Tracks that DO exist for this app right now:")
          tracks.each { |name| UI.error("  - #{name}") }
        end
      elsif release_status == "draft"
        UI.error("The phone release is a DRAFT, so nothing reached testers; re-running this")
        UI.error("workflow publishes both artifacts afresh.")
      else
        UI.error("The phone release is LIVE with no watch app. Re-running this workflow ships")
        UI.error("both, but users are without the watch app until then.")
      end
      UI.error("=" * 78)
      raise
    end
  end

  desc "Build Android AdHoc app"
  lane :adhoc do
    # Use short commit hash as versionCode
    commit_hash = sh("git rev-parse --short HEAD").strip
    version_code = commit_hash.hex % 2147483647 # Android max int
    gradle(
      task: "assembleRelease",
      project_dir: "android",
      properties: {
        "android.injected.version.code" => version_code,
        "android.injected.signing.store.file" => ENV['ANDROID_KEYSTORE_PATH'],
        "android.injected.signing.store.password" => ENV['ANDROID_KEYSTORE_PASSWORD'],
        "android.injected.signing.key.alias" => ENV['ANDROID_KEY_ALIAS'],
        "android.injected.signing.key.password" => ENV['ANDROID_KEY_PASSWORD']
      }
    )
  end

  # Build BOTH Android artifacts, then upload BOTH — the phone AAB to a mobile track and the
  # Wear OS AAB to its own `wear:` form-factor track.
  #
  # ONE BODY, THREE LANES (`beta`, `upload_release`, `nightly`). These were two near-identical
  # 50-line copies before Story 16.36; a third would have been the one that drifted. What
  # actually differs between them is three values, so three values are what they pass.
  #
  # ORDER IS LOAD-BEARING — build everything before uploading anything:
  #
  #   build phone AAB -> build+verify Wear AAB -> upload phone -> upload Wear
  #
  # so a Kotlin error, an R8 failure, a missing artifact or a signing-certificate mismatch all
  # happen while NOTHING has been uploaded. What remains inside the risk window is only the two
  # `upload_to_play_store` calls, and that window is irreducible: `supply` declares
  # `:apk`/`:apk_paths` as `conflicting_options` with `:aab`/`:aab_paths`, so one invocation
  # carries bundles or APKs, never both. Do not interleave a build between the two uploads —
  # that reintroduces the phone-only release through a different door (Story 16.35, review #2).
  private_lane :ship_android! do |options|
    track = options.fetch(:track)
    release_status = options.fetch(:release_status)
    upload = options.fetch(:upload)

    UI.user_error!("Missing ANDROID_PACKAGE_NAME") unless package_name
    UI.user_error!("Missing PLAY_STORE_API_KEY") unless json_key_data

    ensure_android_signing_env!
    ensure_wear_track_resolvable!(track)

    # versionCode is set authoritatively by app.config.ts at `expo prebuild` time (from
    # ANDROID_VERSION_CODE, in the band the calling workflow chose) and baked into the
    # generated build.gradle — see beta-releases.yml, store-upload.yml and
    # nightly-builds.yml. This lane only signs and uploads.
    gradle(
      task: "bundleRelease",
      project_dir: "android",
      properties: {
        "android.injected.signing.store.file" => ENV['ANDROID_KEYSTORE_PATH'],
        "android.injected.signing.store.password" => ENV['ANDROID_KEYSTORE_PASSWORD'],
        "android.injected.signing.key.alias" => ENV['ANDROID_KEY_ALIAS'],
        "android.injected.signing.key.password" => ENV['ANDROID_KEY_PASSWORD']
      }
    )

    # Build and verify the watch half BEFORE either upload, so a Kotlin/R8/signing
    # failure cannot leave a phone-only release behind (Story 16.35).
    wear_bundle = build_wear_bundle!(track: track)

    unless upload
      # `dry_run` from the nightly's workflow_dispatch. Both artifacts are built and the
      # signing-parity gate has passed; the only thing skipped is the pair of irreversible
      # `supply` calls. The workflow keeps both bundles as artifacts.
      UI.important("DRY RUN — built and verified both bundles, skipping both Play uploads.")
      next
    end

    upload_to_play_store(
      package_name: package_name,
      json_key_data: json_key_data,
      track: track,
      release_status: release_status,
      aab: project_path(PHONE_RELEASE_AAB),
      # REQUIRED, and not redundant with passing `aab:` explicitly.
      #
      # upload_to_play_store.rb:10-17 fills `apk:` from `lane_context` whenever neither
      # `apk:` nor `apk_paths:` is given, so a stray APK left by an earlier Gradle step in
      # this lane lands here and supply's verify_config! refuses the pair with "Cannot
      # provide both apk(s) and aab". That is exactly what failed RC v1.0.0-rc.19, when the
      # Wear half still built an APK. It builds a bundle now, so nothing sets that slot —
      # but the guard stays: the failure mode is invisible until a release dies on it.
      #
      # The trap only exists because the build order was changed so BOTH artifacts are built
      # before either is uploaded. That ordering is deliberate and worth keeping (a build
      # failure then cannot strand a phone-only release), so this guard is its cost.
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    # Immediately after the phone upload, onto the Wear form-factor track — see
    # upload_wear_bundle! for why order and same-lane execution are load-bearing.
    upload_wear_bundle!(track: track, release_status: release_status, aab: wear_bundle)
  end

  desc "Build and upload to Play Console (alpha)"
  lane :beta do
    # `draft` is deliberate on the RC lane: promoting an RC to testers stays a human action.
    ship_android!(track: "alpha", release_status: "draft", upload: true)
  end

  desc "Build and upload to Play Store (release)"
  lane :upload_release do
    ship_android!(track: "production", release_status: "completed", upload: true)
  end

  # Nightly internal build (Story 16.36): phone AAB -> `internal`, Wear AAB -> `wear:qa`.
  #
  # `release_status: "completed"`, NOT the `draft` the RC lane uses, and the difference is the
  # whole point rather than an oversight. `beta` uploads a draft so that promoting an RC to
  # testers is a deliberate human click; a nightly whose purpose is unattended delivery cannot
  # require a nightly human click, or it delivers nothing. **Do not "restore consistency" with
  # `beta` here** — that would silently turn the nightly into a queue of undelivered drafts,
  # which looks green from CI and is invisible to the testers waiting for a build.
  #
  # The Wear track is NOT derived from `internal`: Play names the Wear internal-testing track
  # `qa`, so `wear:internal` does not exist. `nightly-builds.yml` sets `WEAR_PLAY_TRACK=wear:qa`
  # and `wear_play_track` uses it verbatim — see that helper for why the derivation is only ever
  # a default (RC v1.0.0-rc.21 died on `Track not found: wear:alpha`).
  desc "Nightly internal build → Play internal + wear:qa (Story 16.36)"
  lane :nightly do |options|
    ship_android!(
      track: "internal",
      release_status: "completed",
      upload: !options[:dry_run]
    )
  end
end
