default_platform(:ios)

app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
watch_identifier = "#{app_identifier}.watch"
# The watch complication is a WidgetKit extension embedded in the watch app. It
# carries the App Groups entitlement, so it needs its own explicit App ID and
# match profile (a wildcard App ID can't hold App Groups).
widget_identifier = "#{watch_identifier}.widget"

def matched_profile_mapping(*bundle_ids)
  mapping = lane_context[Fastlane::Actions::SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}

  bundle_ids.each_with_object({}) do |bundle_id, profiles|
    matched_profile = mapping[bundle_id]
    UI.user_error!("Missing match provisioning profile for #{bundle_id}") unless matched_profile

    profiles[bundle_id] = matched_profile
  end
end

platform :ios do
  before_all do
    # Creates a temporary keychain for match on CI runners.
    # No-op when running locally (unless force: true).
    setup_ci if is_ci
  end

  # Resolves match profiles for the iOS app, the watch app, and the watch
  # widget extension, applies manual code-signing to each target, and returns
  # the bundle-id => profile-name mapping for build_app's export options.
  # All distribution lanes go through here so a target can never be forgotten.
  private_lane :apply_distribution_signing do |options|
    targets_by_identifier = {
      app_identifier => "myLoyaltyCards",
      watch_identifier => "watch",
      widget_identifier => "watchwidget"
    }

    targets_by_identifier.each_key do |bundle_id|
      match(type: options[:match_type], app_identifier: bundle_id, readonly: is_ci)
    end

    profile_mapping = matched_profile_mapping(*targets_by_identifier.keys)

    targets_by_identifier.each do |bundle_id, target_name|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "ios/myLoyaltyCards.xcodeproj",
        team_id: ENV['FASTLANE_TEAM_ID'],
        profile_name: profile_mapping.fetch(bundle_id),
        code_sign_identity: "iPhone Distribution",
        targets: [target_name]
      )
    end

    profile_mapping
  end

  desc "Fetch certificates (appstore, adhoc, development)"
  lane :fetch_certificates do
    [app_identifier, watch_identifier, widget_identifier].each do |id|
      match(
        type: 'development',
        app_identifier: id
      )
      match(
        type: 'adhoc',
        app_identifier: id
      )
      match(
        type: 'appstore',
        app_identifier: id
      )
    end
  end

  desc "Build iOS Dev app"
  lane :build_dev do
    build_app(
      scheme: "myLoyaltyCards",
      export_method: "development",
      xcargs: "DEVELOPMENT_TEAM='#{ENV['FASTLANE_TEAM_ID']}'"
    )
  end

  desc "Build iOS AdHoc app"
  lane :adhoc do
    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY_KEY'],
      in_house: false
    )

    # Sign the iOS app, watch app, and watch widget extension, then export with
    # the exact profile names resolved by match.
    profile_mapping = apply_distribution_signing(match_type: "adhoc")

    # Use CI run number for a guaranteed-unique, ever-increasing build number.
    # Falls back to Unix timestamp when running locally.
    build_number = ENV['GITHUB_RUN_NUMBER'] || Time.now.to_i.to_s
    increment_build_number(
      xcodeproj: "ios/myLoyaltyCards.xcodeproj",
      build_number: build_number
    )
    build_app(
      scheme: "myLoyaltyCards",
      workspace: "ios/myLoyaltyCards.xcworkspace",
      export_method: "ad-hoc",
      output_directory: "output",
      export_options: {
        provisioningProfiles: profile_mapping
      },
      xcargs: "DEVELOPMENT_TEAM='#{ENV['FASTLANE_TEAM_ID']}'"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY_KEY'],
      in_house: false
    )

    profile_mapping = apply_distribution_signing(match_type: "appstore")

    # Retrieve last build number from TestFlight and increment
    last_build = latest_testflight_build_number(
      app_identifier: app_identifier,
      api_key: api_key
    )
    increment_build_number(
      xcodeproj: "ios/myLoyaltyCards.xcodeproj",
      build_number: (last_build.to_i + 1).to_s
    )
    build_app(
      scheme: "myLoyaltyCards",
      workspace: "ios/myLoyaltyCards.xcworkspace",
      export_method: "app-store",
      output_directory: "output",
      export_options: {
        provisioningProfiles: profile_mapping
      },
      xcargs: "DEVELOPMENT_TEAM='#{ENV['FASTLANE_TEAM_ID']}'"
    )
    upload_to_testflight(
      api_key: api_key
    )
  end

  desc "Build and upload to App Store Connect (release)"
  lane :upload_release do
    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY_KEY'],
      in_house: false
    )

    profile_mapping = apply_distribution_signing(match_type: "appstore")

    build_number = ENV['GITHUB_RUN_NUMBER'] || Time.now.to_i.to_s
    increment_build_number(
      xcodeproj: "ios/myLoyaltyCards.xcodeproj",
      build_number: build_number
    )
    build_app(
      scheme: "myLoyaltyCards",
      workspace: "ios/myLoyaltyCards.xcworkspace",
      export_method: "app-store",
      output_directory: "output",
      export_options: {
        provisioningProfiles: profile_mapping
      },
      xcargs: "DEVELOPMENT_TEAM='#{ENV['FASTLANE_TEAM_ID']}'"
    )
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end
end

# Release-signing credentials the Android release build requires. The
# Expo-generated build.gradle points the `release` buildType at the *debug*
# signingConfig, so real upload-key signing only happens when these are injected
# via gradle. Guard their presence so a release can never silently ship
# debug-signed. (Story 16.7, AC5)
ANDROID_SIGNING_ENV_VARS = %w[
  ANDROID_KEYSTORE_PATH
  ANDROID_KEYSTORE_PASSWORD
  ANDROID_KEY_ALIAS
  ANDROID_KEY_PASSWORD
].freeze

def ensure_android_signing_env!
  missing = ANDROID_SIGNING_ENV_VARS.select { |name| ENV[name].to_s.strip.empty? }
  UI.user_error!("Missing Android release-signing env var(s): #{missing.join(', ')}") unless missing.empty?
end

# Artifact paths shared by the phone and Wear halves of an Android release
# (Story 16.35). Named here rather than inlined so the upload, the signing-parity
# check and the "did it actually build" guard can never drift apart.
#
# Kept project-root-relative for readability, and ALWAYS passed through
# `project_path` before use — see the warning on that method. Do not hand a bare
# constant to `Dir.glob`, `File.exist?` or `sh`.
PHONE_RELEASE_AAB = "android/app/build/outputs/bundle/release/app-release.aab".freeze
WEAR_RELEASE_APK_DIR = "watch-android/app/build/outputs/apk/release".freeze

# ⚠️ A LANE BODY'S WORKING DIRECTORY IS `fastlane/`, NOT THE PROJECT ROOT.
#
# fastlane wraps the entire lane in `Dir.chdir(FastlaneCore::FastlaneFolder.path)`
# (`runner.rb`) and chdirs out to the project root only *inside* an action
# (`execute_action`'s `custom_dir` defaults to `".."`). So within one lane there are
# two different working directories:
#
#   * action PARAMETERS (`gradle(project_dir:)`, `upload_to_play_store(aab:)`) are
#     resolved by the action, i.e. against the PROJECT ROOT — which is why the
#     relative paths elsewhere in this file work;
#   * raw Ruby in the lane body (`Dir.glob`, `File.exist?`) and `sh` both run
#     against `fastlane/`, because `FastFile#sh` calls `Actions.sh_no_action`
#     directly and never chdirs.
#
# That split silently broke the first draft of `wear_release_apk!`: its glob found
# nothing even with the APK on disk, aborting the lane AFTER the phone AAB had been
# uploaded — the phone-only release this whole story exists to prevent. Absolute
# paths are correct under both directories, so everything goes through here.
def project_path(relative)
  File.expand_path(relative, File.expand_path("..", FastlaneCore::FastlaneFolder.path || Dir.pwd))
end

# Resolve the Wear OS release APK by globbing rather than by name, and refuse the
# unsigned one.
#
# AGP names the artifact from whether a signing config APPLIED: `app-release.apk`
# when one did, `app-release-unsigned.apk` when none did. `watch-android` declares no
# `signingConfig` on purpose (no keystore lives in this repo), so a local
# `assembleRelease` genuinely produces the `-unsigned` name — verified locally. The
# release lanes get the signed name only because they inject
# `android.injected.signing.*`. Hardcoding either name therefore encodes an assumption
# about whether injection worked, which is precisely the thing being checked.
#
# The signing-parity check downstream would also catch an unsigned APK (apksigner
# prints no certificate digest for one), but failing here says WHY in one line
# instead of making someone read apksigner output.
def wear_release_apk!
  # Absolute — a lane body's cwd is `fastlane/`. See `project_path`.
  candidates = Dir.glob(File.join(project_path(WEAR_RELEASE_APK_DIR), "*.apk")).sort

  if candidates.empty?
    UI.user_error!(
      "No Wear OS release APK in #{WEAR_RELEASE_APK_DIR}. The phone AAB has already been " \
      "uploaded; failing here rather than publishing a phone-only release (Story 16.35, AC6)."
    )
  end
  if candidates.length > 1
    UI.user_error!(
      "Expected exactly one Wear OS release APK in #{WEAR_RELEASE_APK_DIR}, found " \
      "#{candidates.length}: #{candidates.join(', ')}. Refusing to guess which one to ship."
    )
  end

  apk = candidates.first
  if File.basename(apk).include?("-unsigned")
    UI.user_error!(
      "Wear OS release APK is UNSIGNED (#{apk}). The `android.injected.signing.*` " \
      "properties did not take effect, so Play would reject it — and a wrong-key APK " \
      "would be worse: it uploads cleanly and breaks the Wearable Data Layer silently."
    )
  end

  apk
end

# The phone's versionCode for the release currently being shipped. `app.config.ts`
# bakes it into the AAB manifest at prebuild time from ANDROID_VERSION_CODE, and the
# Wear upload needs it verbatim for `version_codes_to_retain` — see ship_wear_apk!.
#
# Required, never inferred: locally `resolveAndroidVersionCode` falls back to a Unix
# timestamp that Fastlane cannot see, and guessing wrong here would drop the phone
# from the Play release rather than fail.
def phone_version_code!
  raw = ENV['ANDROID_VERSION_CODE'].to_s.strip
  # Base 10 is PINNED. Bare `Integer()` honours radix prefixes, so "042" would parse
  # as octal 34 while `app.config.ts`'s `Number("042")` — the value actually baked
  # into the AAB — is 42. `version_codes_to_retain: [34]` would then retain a
  # versionCode that does not exist and drop the phone from the release.
  parsed = Integer(raw, 10, exception: false)
  unless parsed&.positive?
    UI.user_error!(
      "ANDROID_VERSION_CODE is #{raw.empty? ? 'unset' : "\"#{raw}\""} but must be a positive " \
      "integer. It is the phone versionCode that version_codes_to_retain must carry, so an " \
      "unknown value would publish a Play release containing ONLY the Wear APK (Story 16.35, AC3)."
    )
  end
  parsed
end

platform :android do
  package_name = ENV['ANDROID_PACKAGE_NAME'] || CredentialsManager::AppfileConfig.try_fetch_value(:package_name)
  json_key_data = ENV['PLAY_STORE_API_KEY']

  desc "Build Android Dev app"
  lane :build_dev do
    gradle(task: "assembleDebug", project_dir: "android")
  end

  # Build, sign and ship the Wear OS companion APK into the Play track release the
  # phone AAB was JUST uploaded into (Story 16.35). Call this AFTER the phone
  # upload, in the SAME lane — never as a parallel job.
  #
  # Three constraints are load-bearing; changing any of them silently ships a
  # broken release:
  #
  # 1. ONE RELEASE, TWO VERSION CODES. The Wear APK shares `applicationId` with the
  #    phone app, so Play sees one app whose track release must list both version
  #    codes. `upload_to_play_store` creates a NEW release on the track every time
  #    it is called, so without `version_codes_to_retain` this second call would
  #    publish a release containing only the Wear APK — un-delivering the phone.
  #    The Play Console would look perfectly healthy either way.
  # 2. APK **OR** AAB, NEVER BOTH. `supply` cannot carry an AAB and an APK in one
  #    invocation (hence `skip_upload_apk`/`skip_upload_aab`), and multiple AABs are
  #    unsupported. The phone ships an AAB and Wear ships an APK, so two calls is
  #    not a style choice — it is the only shape that exists.
  # 3. SEQUENTIAL, SAME JOB. Two jobs uploading concurrently race the same Play
  #    track edit and one silently loses. The toolchain cost of merging the Node/
  #    Expo half and the JDK 17/Android SDK half into one job is deliberate.
  #
  # The Wear versionCode band is chosen HERE from the upload track, not in the
  # workflow, so the band and the destination track cannot disagree. See
  # `wearProductionVersionCodeOffset` in watch-android/app/build.gradle.kts.
  private_lane :ship_wear_apk! do |options|
    track = options.fetch(:track)
    retain = [options.fetch(:phone_version_code)]

    ENV['WEAR_RELEASE_TRACK'] = track == "production" ? "production" : "beta"

    gradle(
      task: "assembleRelease",
      project_dir: "watch-android",
      properties: {
        "android.injected.signing.store.file" => ENV['ANDROID_KEYSTORE_PATH'],
        "android.injected.signing.store.password" => ENV['ANDROID_KEYSTORE_PASSWORD'],
        "android.injected.signing.key.alias" => ENV['ANDROID_KEY_ALIAS'],
        "android.injected.signing.key.password" => ENV['ANDROID_KEY_PASSWORD']
      }
    )

    # AC6: never degrade to a phone-only release. Resolves the artifact and rejects
    # both "nothing was built" and "what was built is unsigned".
    wear_apk = wear_release_apk!

    # AC5: the Wear APK and the phone AAB must carry the SAME signing certificate.
    # An unsigned APK fails loudly at Play, but a wrong-key APK uploads cleanly and
    # then breaks the Wearable Data Layer with no crash and no telemetry. The check
    # also prints the fingerprint the Digital Asset Links entry needs.
    # All paths absolute: `sh` runs from `fastlane/`. See `project_path`.
    sh(
      "node",
      project_path("scripts/check-android-signing-parity.mjs"),
      project_path(PHONE_RELEASE_AAB),
      wear_apk
    )

    upload_to_play_store(
      package_name: package_name,
      json_key_data: json_key_data,
      track: track,
      release_status: options.fetch(:release_status),
      apk: wear_apk,
      # Without this the phone's versionCode drops out of the track release.
      version_codes_to_retain: retain,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build Android AdHoc app"
  lane :adhoc do
    # Use short commit hash as versionCode
    commit_hash = sh("git rev-parse --short HEAD").strip
    version_code = commit_hash.hex % 2147483647 # Android max int
    gradle(
      task: "assembleRelease",
      project_dir: "android",
      properties: {
        "android.injected.version.code" => version_code,
        "android.injected.signing.store.file" => ENV['ANDROID_KEYSTORE_PATH'],
        "android.injected.signing.store.password" => ENV['ANDROID_KEYSTORE_PASSWORD'],
        "android.injected.signing.key.alias" => ENV['ANDROID_KEY_ALIAS'],
        "android.injected.signing.key.password" => ENV['ANDROID_KEY_PASSWORD']
      }
    )
  end

  desc "Build and upload to Play Console (alpha)"
  lane :beta do
    UI.user_error!("Missing ANDROID_PACKAGE_NAME") unless package_name
    UI.user_error!("Missing PLAY_STORE_API_KEY") unless json_key_data

    ensure_android_signing_env!
    # PREFLIGHT, deliberately before the phone upload: the Wear half needs this
    # value for `version_codes_to_retain`, and discovering it is missing AFTER the
    # AAB is on the track would leave exactly the phone-only release this story
    # exists to prevent. Nothing here depends on the build, so it costs nothing.
    phone_version_code = phone_version_code!

    # versionCode is set authoritatively by app.config.ts at `expo prebuild`
    # time (from ANDROID_VERSION_CODE) and baked into the generated build.gradle
    # — see beta-releases.yml. This lane only signs and uploads the AAB.
    gradle(
      task: "bundleRelease",
      project_dir: "android",
      properties: {
        "android.injected.signing.store.file" => ENV['ANDROID_KEYSTORE_PATH'],
        "android.injected.signing.store.password" => ENV['ANDROID_KEYSTORE_PASSWORD'],
        "android.injected.signing.key.alias" => ENV['ANDROID_KEY_ALIAS'],
        "android.injected.signing.key.password" => ENV['ANDROID_KEY_PASSWORD']
      }
    )
    upload_to_play_store(
      package_name: package_name,
      json_key_data: json_key_data,
      track: "alpha",
      release_status: "draft",
      aab: project_path(PHONE_RELEASE_AAB),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    # The watch half of the same release. MUST come after the phone upload and stay
    # in this lane — see ship_wear_apk! for why splitting it drops the phone from
    # the Play release (Story 16.35).
    ship_wear_apk!(
      track: "alpha",
      release_status: "draft",
      phone_version_code: phone_version_code
    )
  end

  desc "Build and upload to Play Store (release)"
  lane :upload_release do
    UI.user_error!("Missing ANDROID_PACKAGE_NAME") unless package_name
    UI.user_error!("Missing PLAY_STORE_API_KEY") unless json_key_data

    ensure_android_signing_env!
    # PREFLIGHT — see the `beta` lane above for why this must not wait until after
    # the phone upload.
    phone_version_code = phone_version_code!

    # versionCode is set authoritatively by app.config.ts at `expo prebuild`
    # time (from ANDROID_VERSION_CODE, production offset band) and baked into the
    # generated build.gradle — see store-upload.yml. This lane signs and uploads.
    gradle(
      task: "bundleRelease",
      project_dir: "android",
      properties: {
        "android.injected.signing.store.file" => ENV['ANDROID_KEYSTORE_PATH'],
        "android.injected.signing.store.password" => ENV['ANDROID_KEYSTORE_PASSWORD'],
        "android.injected.signing.key.alias" => ENV['ANDROID_KEY_ALIAS'],
        "android.injected.signing.key.password" => ENV['ANDROID_KEY_PASSWORD']
      }
    )
    upload_to_play_store(
      package_name: package_name,
      json_key_data: json_key_data,
      track: "production",
      aab: project_path(PHONE_RELEASE_AAB),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    # The watch half of the same release (Story 16.35, AC2). Production needs this
    # as much as the RC track does: shipping the watch app to testers but not to
    # production would silently DOWNGRADE those users on the next release — no
    # crash, no telemetry, and the Play Console would look correct.
    #
    # `release_status` is left at supply's default (`completed`) to match the phone
    # upload directly above, so both artifacts land in one fully-released release.
    ship_wear_apk!(
      track: "production",
      release_status: "completed",
      phone_version_code: phone_version_code
    )
  end
end
