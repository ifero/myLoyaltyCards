{
  "expo": {
    "name": "Cardì",
    "slug": "myloyaltycards",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cardi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iferoporefi.myloyaltycards",
      "minimumOsVersion": "18.0",
      "appleTeamId": "7KU8K25XK5",
      "infoPlist": {
        "CFBundleName": "Cardì",
        "NSCameraUsageDescription": "Allow Cardì to access your camera to scan loyalty card barcodes",
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#181824"
      },
      "package": "com.iferoporefi.myloyaltycards"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Cardì to access your camera to scan loyalty card barcodes",
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  { "path": "./assets/fonts/inter/Inter-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/inter/Inter-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/inter/Inter-Bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "Space Grotesk",
                "fontDefinitions": [
                  { "path": "./assets/fonts/space-grotesk/SpaceGrotesk-Bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "JetBrains Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/jetbrains-mono/JetBrainsMono-Medium.ttf",
                    "weight": 500
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/inter/Inter-Regular.ttf",
              "./assets/fonts/inter/Inter-SemiBold.ttf",
              "./assets/fonts/inter/Inter-Bold.ttf",
              "./assets/fonts/space-grotesk/SpaceGrotesk-Bold.ttf",
              "./assets/fonts/jetbrains-mono/JetBrainsMono-Medium.ttf"
            ]
          }
        }
      ],
      "./plugins/with-watch-accent-color",
      "@bacons/apple-targets",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cardì to access your photos to scan loyalty card barcodes from images."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ],
      "expo-localization",
      [
        "@sentry/react-native",
        {
          "organization": "andrea-pacino",
          "project": "react-native",
          "url": "https://de.sentry.io/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "backgroundColor": "#181824"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1861d36e-c8a8-4912-8ce4-67ac585e74ee"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1861d36e-c8a8-4912-8ce4-67ac585e74ee"
    }
  }
}
