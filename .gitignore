# Lock files
package-lock.json

# WatchOS (targets/watch — source managed by @bacons/apple-targets)
targets/watch/Generated/*
!targets/watch/Generated/Brands.swift
targets/watch/generated.entitlements

# WatchOS widget (targets/watch-widget — generated brand-logo catalog is tracked)
targets/watch-widget/Generated/*
!targets/watch-widget/Generated/BrandLogoCatalog.generated.swift

# WatchOS build artifacts (watch-ios/ — only Scripts/, Tests/, UITests/ are source)
watch-ios/.derivedData/
watch-ios/Generated/
watch-ios/build/
watch-ios/test-results.xcresult/
watch-ios/MyLoyaltyCardsWatch.xcodeproj/xcuserdata/

# Wear OS build artifacts (watch-android/ — a STANDALONE Gradle project, not part
# of the gitignored prebuild-generated android/). Only build output is ignored:
# every source file AND the Gradle wrapper (gradlew, gradlew.bat,
# gradle/wrapper/*) stay tracked, or the build stops being reproducible.
watch-android/**/build/
watch-android/.gradle/
watch-android/.kotlin/
watch-android/local.properties
watch-android/**/*.apk
watch-android/**/*.aab

# Fastlane
bundler/
fastlane/.env.default

# Claude Code local (personal) settings
.claude/settings.local.json

# Claude Code git worktrees — full nested checkouts of this repo, one per in-flight branch
# (hundreds of thousands of duplicate files). Ignored here rather than only in .git/info/exclude,
# which is local to one clone and never committed: tools that read .gitignore but cannot see
# info/exclude — prettier among them — otherwise walk every copy. Tools that read neither carry
# their own entry instead (see eslint.config.mjs `ignores` and jest.config.js path guards).
.claude/worktrees/

# BMAD personal install answers (installer-regenerated per developer; shared config lives in
# _bmad/config.toml and _bmad/custom/config.toml, which ARE committed)
_bmad/config.user.toml

# BMAD generic output folder — transient, per-developer session output (party-mode memories and
# keepsakes, brainstorming scratch). Every artifact that IS a project record is pinned to docs/ via
# _bmad/custom/config.toml, so nothing durable should ever land here.
_bmad-output/