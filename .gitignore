# Build outputs — the prebuild-generated native projects at the repo root.
#
# ⚠️ These patterns are UNANCHORED, so they match a directory named `android`/`ios` at ANY
# depth, not just the two at the root. That bites local Expo modules (Story 10-6): a module's
# native source lives at `modules/<name>/android/`, which this pattern silently swallows — the
# TypeScript half of the module would be committed and the Kotlin half would not, producing a
# tree that builds for the author and for nobody else.
#
# Anchoring them (`/android/`) would be the tidier fix, but it would also un-ignore any nested
# native directory elsewhere in the tree in one go. The negations below are the surgical
# version: they cover exactly the case that exists, and any future local module inherits them.
android/
ios/

# Local Expo modules are TRACKED SOURCE, including their native halves. They sit outside the
# generated `android/` precisely so they survive `expo prebuild`, which makes losing them to the
# rule above the exact opposite of the intent.
#
# Git cannot re-include a file whose parent DIRECTORY is excluded, so the directory itself has to
# be un-ignored first; only then does the build-output rule that follows get a say.
!modules/*/android/
!modules/*/ios/
modules/*/android/build/
modules/*/android/.cxx/
modules/*/ios/build/

# @generated expo-cli sync-2b81b286409207a5da26e14c78851eb30d8ccbdb
# The following patterns were generated by expo-cli

expo-env.d.ts
# @end expo-cli

# Lock files
package-lock.json

# WatchOS (targets/watch — source managed by @bacons/apple-targets)
targets/watch/Generated/*
!targets/watch/Generated/Brands.swift
targets/watch/generated.entitlements

# WatchOS widget (targets/watch-widget — generated brand-logo catalog is tracked)
targets/watch-widget/Generated/*
!targets/watch-widget/Generated/BrandLogoCatalog.generated.swift

# WatchOS build artifacts (watch-ios/ — only Scripts/, Tests/, UITests/ are source)
watch-ios/.derivedData/
watch-ios/Generated/
watch-ios/build/
watch-ios/test-results.xcresult/
watch-ios/MyLoyaltyCardsWatch.xcodeproj/xcuserdata/

# Wear OS build artifacts (watch-android/ — a STANDALONE Gradle project, not part
# of the gitignored prebuild-generated android/). Only build output is ignored:
# every source file AND the Gradle wrapper (gradlew, gradlew.bat,
# gradle/wrapper/*) stay tracked, or the build stops being reproducible.
watch-android/**/build/
watch-android/.gradle/
watch-android/.kotlin/
watch-android/local.properties
watch-android/**/*.apk
watch-android/**/*.aab

# Wear OS generated brand catalogue (watch-android — the generated Brands.kt is tracked).
# Same ignore-the-directory / un-ignore-the-file shape as targets/watch/Generated above,
# and for the same reason: a gitignored artifact cannot be drift-checked, so a stale
# catalogue would ship in silence. `yarn wear:catalogue:check` gates it in pre-push and CI.
# The one thing the directory rule quietly covers is the generator's
# .catalogue-inputs.sha256 sidecar — machine state for the incremental skip, not an artifact.
watch-android/app/src/main/kotlin/com/iferoporefi/myloyaltycards/wear/Generated/*
!watch-android/app/src/main/kotlin/com/iferoporefi/myloyaltycards/wear/Generated/Brands.kt

# Fastlane
bundler/
fastlane/.env.default

# Claude Code local (personal) settings
.claude/settings.local.json

# Claude Code git worktrees — full nested checkouts of this repo, one per in-flight branch
# (hundreds of thousands of duplicate files). Ignored here rather than only in .git/info/exclude,
# which is local to one clone and never committed: tools that read .gitignore but cannot see
# info/exclude — prettier among them — otherwise walk every copy. Tools that read neither carry
# their own entry instead (see eslint.config.mjs `ignores` and jest.config.js path guards).
.claude/worktrees/

# BMAD personal install answers (installer-regenerated per developer; shared config lives in
# _bmad/config.toml and _bmad/custom/config.toml, which ARE committed)
_bmad/config.user.toml

# BMAD generic output folder — transient, per-developer session output (party-mode memories and
# keepsakes, brainstorming scratch). Every artifact that IS a project record is pinned to docs/ via
# _bmad/custom/config.toml, so nothing durable should ever land here.
_bmad-output/

# Playwright MCP server scratch output — console/network captures written into the
# working directory while the server drives a browser. Per-session tool noise, never
# a project record, and it lands in whichever directory the session happens to run in.
.playwright-mcp/

# Python bytecode caches — the design-frame generators and their check are Python,
# so running any of them leaves these behind next to the source.
__pycache__/
*.py[cod]
