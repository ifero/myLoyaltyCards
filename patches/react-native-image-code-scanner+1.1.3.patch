+  // MARK: - Resample Retry
+
+  /// Minimum longest edge, in pixels, for the resample retry to be worth trying.
+  ///
+  /// Below this a downscaled copy has too few pixels left to hold a scannable
+  /// barcode, so the extra Vision passes would cost time and find nothing.
+  private static let resampleMinimumEdge: CGFloat = 400
+
+  /// Downscale factors tried after every other candidate has missed.
+  ///
+  /// Measured against a real failing card: every factor from 0.85x down to 0.25x
+  /// made Vision decode it, bilinear and Lanczos alike, so these are points
+  /// inside a wide stable window rather than magic numbers. Two rather than one
+  /// because the underlying defect is "rasterised at 1/N of the needed size then
+  /// upscaled N times", and N varies between cards.
+  ///
+  /// A fixed-radius blur was measured and rejected: r=2.0 decodes but r=1.5 and
+  /// r=2.5 both miss, which is far too fragile. Upscaling (tested to 4836px) and
+  /// binarising never decode at all — once edge positions are quantised away
+  /// they cannot be recovered by adding pixels, only by resampling.
+  private static let resampleFactors: [CGFloat] = [0.6, 0.45]
+
+  /// Downscale by an explicit factor, for the resample retry.
+  ///
+  /// Deliberately distinct from `scaleImageIfNeeded`, which fires only ABOVE a
+  /// size ceiling. That ceiling is why this retry is needed at all: anything
+  /// wider than 2048px already gets resampled on the way in and decodes, so it
+  /// is specifically SMALL, marginally-rendered images that reach the decoder
+  /// with their quantisation intact.
+  ///
+  /// Returns an `.up` image — `draw(in:)` bakes orientation into the pixels —
+  /// which is the same contract `rotateImage` above already produces.
+  private func downscale(_ image: UIImage, factor: CGFloat) -> UIImage? {
+    guard let currentCGImage = image.cgImage else { return nil }
+
+    let newW = floor(CGFloat(currentCGImage.width) * factor)
+    let newH = floor(CGFloat(currentCGImage.height) * factor)
+    guard newW >= 1, newH >= 1 else { return nil }
+
+    let newSizePx = CGSize(width: newW, height: newH)
+    let format = UIGraphicsImageRendererFormat.default()
+    format.scale = 1 // render size is in pixels
+    return UIGraphicsImageRenderer(size: newSizePx, format: format).image { _ in
+      image.draw(in: CGRect(origin: .zero, size: newSizePx))
+    }
+  }
+
