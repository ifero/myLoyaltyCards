<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. minSdk is 30, so this v26-qualified resource always
  matches and no legacy square fallback is needed.

  The foreground and background are a faithful copy of the phone app's declared
  Android icon (app.json -> expo.android.adaptiveIcon), not new artwork: the
  companion app should look like the app it companions. Nothing keeps the two in
  sync automatically — see README.md § Known gaps.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
