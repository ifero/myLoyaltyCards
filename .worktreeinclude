# Gitignored files Claude Code copies from the main checkout into every worktree it creates
# (desktop parallel sessions, `claude --worktree`, subagent worktrees). gitignore syntax. A file is
# copied only when it matches a line here AND is gitignored, so nothing tracked is ever duplicated.
# Worktrees that already exist are not back-filled: copy the files into those by hand.

# BMAD per-user config. Without these, every BMAD skill HALTs on
# "missing config value `communication_language`" before it starts.
_bmad/config.user.toml
_bmad/custom/config.user.toml

# App environment (Supabase, Sentry). Without it the app boots with Supabase unconfigured.
/.env

# Local Claude Code permission allowlist.
.claude/settings.local.json
